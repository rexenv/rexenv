#!/bin/bash
# Before pushing a `v*` tag to rexenv/rexenv: the tag must name the version the tree declares.
#
# Installed via `core.hooksPath` (see CONTRIBUTING.md), so it is versioned with the repo
# rather than living unshared in `.git/hooks`.
#
# ── WHAT THIS USED TO BE, AND WHY IT CHANGED ────────────────────────────────
#
# From 16 Aug to 27 Sep 2026 this hook REFUSED every `v*` tag push while the repo was
# private: `release.yml` fired on the tag, spent 10×-billed macOS minutes, and drafted a
# release HERE — next to the real one on the tap, which was cut by hand from a laptop.
# Keeping the tag local was the interim flow, and the hook made that a mechanism rather
# than a memory.
#
# On 27 Sep 2026 the owner ruled the opposite (docs/PLAN-ci-release.md): every release is
# built ONLY on GitHub Actions, every OS at once, and `release.yml` now drafts the release
# ON THE TAP (with TAP_TOKEN) with all eight assets. Pushing the tag IS the release. The
# refusal's three reasons are gone — the minutes buy the build nobody's laptop shaped, the
# artefacts land where `brew` can fetch them, and nothing is drafted in this repo — so the
# refusal is gone too. A guard that outlives its reason trains `--no-verify` into a habit.
#
# ── WHAT IT GUARDS NOW ──────────────────────────────────────────────────────
#
# The one thing a local hook can still catch before a 40-minute build: a tag that
# disagrees with the four version manifests. `release.yml`'s first job runs the same
# `scripts/check-versions.sh` and would fail in seconds — but a tag pushed to origin is a
# tag GitHub has seen, and the fix is a second tag rather than a deletion. Better refused
# here, from the tree the tag points at.
#
# ── WHAT IT DOES NOT CATCH ──────────────────────────────────────────────────
#
#   1. Anything but `v*` tags to this repo's own remote.
#   2. `Actions → Release → Run workflow`, which creates the tag itself (and runs the
#      same guard first).
#   3. `--no-verify`, deliberately. This is an honesty aid on your own machine.
#
# Tag DELETIONS are allowed.

set -euo pipefail

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

case "$REMOTE_URL" in
  *rexenv/rexenv.git | *rexenv/rexenv | *rexenv/rexenv/) ;;
  *) exit 0 ;;
esac

ZERO='0000000000000000000000000000000000000000'
ROOT="$(git rev-parse --show-toplevel)"
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in refs/tags/v*) ;; *) continue ;; esac
  [ "$local_sha" = "$ZERO" ] && continue # a deletion builds nothing
  tag="${remote_ref#refs/tags/}"
  version="${tag#v}"
  # The manifests AT THE TAGGED COMMIT, not the working tree: what CI will build.
  commit="$(git rev-parse "${local_sha}^{commit}")"
  # check-versions.sh cd's to ITS OWN repo root, so it is copied beside the manifests it
  # should read — the tagged commit's, in a scratch tree, never the working tree's.
  tmp="$(mktemp -d)"
  for f in src-tauri/tauri.conf.json package.json src-tauri/Cargo.toml cli/Cargo.toml scripts/check-versions.sh; do
    mkdir -p "$tmp/$(dirname "$f")"
    git show "$commit:$f" > "$tmp/$f"
  done
  chmod +x "$tmp/scripts/check-versions.sh"
  if ! "$tmp/scripts/check-versions.sh" "$version" >/dev/null 2>&1; then
    printf '\n  ✗ pre-push: %s names %s, but the manifests at %s disagree:\n\n' "$tag" "$version" "${commit:0:8}" >&2
    "$tmp/scripts/check-versions.sh" "$version" 2>&1 | sed 's/^/      /' >&2 || true
    printf '\n  Bump all four (docs/RELEASING.md step 1), commit, and tag THAT commit.\n\n' >&2
    rm -rf "$tmp"
    exit 1
  fi
  rm -rf "$tmp"
  echo "pre-push: $tag agrees with the manifests at ${commit:0:8} — release.yml will build it on GitHub"
done
exit 0
