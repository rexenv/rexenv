{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rexenv",
  "version": "0.8.11",
  "identifier": "dev.rexenv.rexenv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "sh scripts/build-cli.sh && pnpm dev",
    "beforeBuildCommand": "sh scripts/build-cli.sh && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "rexenv",
        "visible": false,
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.w.org; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src rexdb: http://rexdb.localhost https://rexdb.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.w.org; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; frame-src rexdb: http://rexdb.localhost https://rexdb.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/rex"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "xdg-utils",
          "libnss3-tools",
          "pkexec | policykit-1",
          "libaio1 | libaio1t64",
          "libnuma1",
          "libxml2 | libxml2-16",
          "libssl3 | libssl3t64",
          "libzstd1",
          "liblz4-1",
          "libkrb5-3",
          "libgssapi-krb5-2",
          "libxxhash0",
          "zlib1g",
          "libcom-err2",
          "libkeyutils1"
        ],
        "files": {
          "/usr/share/polkit-1/actions/dev.rexenv.rexenv.policy": "linux/dev.rexenv.rexenv.policy",
          "/usr/libexec/rexenv/privileged-update": "linux/rexenv-privileged-update"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        }
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
